---
// Layout for /uses (src/pages/uses.md): intro body, then boxed sections of rows:
// a name with an optional writeup (inline Markdown; a blank line in the YAML folds to "\n"
// and starts a new paragraph) underneath.
import Layout from './Layout.astro';
import { inlineMd } from '../lib/markdown';

interface Item { name: string; text?: string }
interface Section { title: string; items: Item[] }
const { title, description, heading, lede, sections = [] } = Astro.props.frontmatter as {
  title: string; description: string; heading: string; lede?: string; sections?: Section[];
};
---

<Layout title={title} description={description}>
  <main class="wrap">
    <header class="page-header">
      <h1>{heading}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>

    <div class="prose"><slot /></div>

    {sections.map((section) => (
      <section>
        <h2 class="section-rule"><span>{section.title}</span></h2>
        <div class="uses-group">
          {section.items.map((item) => (
            <div class="uses-row">
              <span class="uses-row-title">{item.name}</span>
              {item.text?.split('\n').map((para) => <p class="uses-row-desc" set:html={inlineMd(para)} />)}
            </div>
          ))}
        </div>
      </section>
    ))}
  </main>
</Layout>
