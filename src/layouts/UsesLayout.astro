---
// Layout for /uses (src/pages/uses.md): intro, then sections of Projects-style rows:
// a name with an optional writeup (inline Markdown; a blank line in the YAML folds to "\n"
// and starts a new paragraph) underneath in muted text.
import Layout from './Layout.astro';
import { inlineMd } from '../lib/markdown';

interface Item { name: string; text?: string }
interface Section { title: string; items: Item[] }
const { title, description, heading, lede, sections = [] } = Astro.props.frontmatter as {
  title: string; description: string; heading: string; lede?: string; sections?: Section[];
};
---

<Layout title={title} description={description}>
  <main class="wrap">
    <header class="page-header">
      <h1>{heading}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>

    {sections.map((section) => (
      <section>
        <h2 class="section-rule"><span>{section.title}</span></h2>
        {section.items.map((item) => (
          <div class="post-row project-row uses-row">
            <span class="post-title">{item.name}</span>
            {item.text?.split('\n').map((para) => <p class="project-summary uses-row-desc" set:html={inlineMd(para)} />)}
          </div>
        ))}
      </section>
    ))}
  </main>
</Layout>
