---
// Decisions — selected ADRs from the homelab, grouped by year.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Newest first; same-day ADRs fall back to number so ties don't depend on load order.
const adrs = (await getCollection('adr')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.data.number - a.data.number
);
const years = [...new Set(adrs.map((a) => a.data.date.getUTCFullYear()))];
const num = (n: number) => String(n).padStart(4, '0');
---

<Layout title="Decisions | Dave Levine" description="Selected architecture decision records from Dave Levine's homelab.">
  <main class="wrap">
    <header class="page-header">
      <h1>Decisions</h1>
      <p class="lede">Selected decision records from my homelab, lightly edited for publishing. Each one explains what I chose, what I passed on, and why.</p>
    </header>

    <div class="prose">
      <p>These are Architecture Decision Records (ADRs), and they follow the <a href="https://cognitect.com/blog/2011/11/15/documenting-architecture-decisions" target="_blank" rel="noopener noreferrer">Michael Nygard style</a>:</p>
      <ul>
        <li>Each ADR is a numbered Markdown file (<code>0001-….md</code>, <code>0002-….md</code>, etc.).</li>
        <li>The number is sequential and permanent; a deprecated ADR is never renumbered.</li>
        <li>Status can be Proposed, Accepted, Superseded, or Deprecated.</li>
      </ul>
      <p>Gaps in the numbering are records I've kept private.</p>
    </div>

    {years.map((y) => (
      <>
        <h2 class="section-rule"><span>{y}</span></h2>
        {adrs.filter((a) => a.data.date.getUTCFullYear() === y).map((a) => (
          <div class="post-row">
            <a class="post-title" href={`/decisions/${a.id}/`}>{a.data.title}</a>
            <span class="post-date">ADR {num(a.data.number)}</span>
          </div>
        ))}
      </>
    ))}
  </main>
</Layout>
