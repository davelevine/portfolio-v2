---
// Cert detail — article layout: title, dates + status, prose (image + verification link).
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, certStatus } from '../../lib/format';

export async function getStaticPaths() {
  const certs = await getCollection('certs');
  return certs.map((cert) => ({ params: { slug: cert.id }, props: { cert } }));
}

const { cert } = Astro.props;
const { Content } = await render(cert);
const { title, excerpt, achievedDate, expirationDate, tech = [] } = cert.data;
---

<Layout title={`${title} | Dave Levine`} description={excerpt}>
  <main class="wrap">
    <article>
      <header class="post-header">
        {tech.length > 0 && (
          <div class="post-tags">
            {tech.map((t) => <span class="chip">{t}</span>)}
          </div>
        )}
        <h1>{title}</h1>
        <p class="post-meta">
          Achieved {formatDate(new Date(achievedDate))}
          {expirationDate !== 'Never' && ` · Expires ${formatDate(new Date(expirationDate))}`}
          <span class="meta-tag" data-expires={expirationDate}>{certStatus(expirationDate)}</span>
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>
      <div class="end-mark" aria-hidden="true"></div>
      <a class="more-link" href="/certs/">&larr; All certs</a>
    </article>
  </main>
</Layout>

<script>
  // The status tag is set at build time; recheck it so a cert that expired since the last
  // deploy doesn't still read Active.
  import { certStatus } from '../../lib/format';

  document.addEventListener('astro:page-load', () => {
    const tag = document.querySelector<HTMLElement>('.meta-tag[data-expires]');
    if (tag) tag.textContent = certStatus(tag.dataset.expires ?? 'Never');
  });
</script>
