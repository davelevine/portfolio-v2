---
// Certs list — ports pages/certs/index.js + components/certs/allCerts.js.
import Layout from '../../layouts/Layout.astro';
import CertItem from '../../components/CertItem.astro';
import { getCollection } from 'astro:content';

const certs = await getCollection('certs');
// achievedDate desc, then: legacy certs last (by title), non-legacy featured-first.
certs.sort((a, b) => new Date(b.data.achievedDate).valueOf() - new Date(a.data.achievedDate).valueOf());
certs.sort((a, b) => {
  const aL = a.data.originalTitle?.includes('(Legacy)');
  const bL = b.data.originalTitle?.includes('(Legacy)');
  if (aL && bL) return a.data.title.localeCompare(b.data.title);
  if (aL) return 1;
  if (bL) return -1;
  return (b.data.isFeatured ? 1 : 0) - (a.data.isFeatured ? 1 : 0);
});
const topics = [...new Set(certs.flatMap((c) => c.data.tech ?? []))].sort();
---

<Layout title="Certifications" description="List of all my certifications.">
  <section class="certs">
    <div id="scroll-progress" class="scrollProgress"></div>

    <div class="container">
      <h1 class="anim-header">CERTIFICATIONS</h1>

      <div class="filter">
        <h3 class="anim-subheader"><p>Sort By Topic</p></h3>
        <div class="filterButtons" id="filterButtons">
          <button class="btn btn-outlined sm active anim-filter-btn" data-topic="all">All</button>
          {topics.map((t, i) => (
            <button class="btn btn-outlined sm anim-filter-btn" data-topic={t} style={`animation-delay: ${(i + 1) * 50}ms`}>{t}</button>
          ))}
        </div>
      </div>

      <div class="galleryWrap">
        <div class="gallery" id="gallery">
          {certs.map((c) => (
            <div class="certCard" data-topic={(c.data.tech ?? []).join('|')}>
              <CertItem
                title={c.data.title}
                excerpt={c.data.excerpt}
                achievedDate={c.data.achievedDate}
                expirationDate={c.data.expirationDate}
                image={c.data.image}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="cert-overlay" id="certOverlay" hidden>
    <div class="cert-modal">
      <button class="cert-close" id="certClose" aria-label="Close"><i class="fa-regular fa-xmark"></i></button>
      <img class="cert-image" id="certImage" src="" alt="" />
    </div>
  </div>
</Layout>

<script>
  const closeCert = () => {
    const overlay = document.getElementById('certOverlay');
    if (overlay) overlay.hidden = true;
    document.body.classList.remove('modal-open');
  };
  function onKey(e: KeyboardEvent) {
    const overlay = document.getElementById('certOverlay');
    if (e.key === 'Escape' && overlay && !overlay.hidden) closeCert();
  }
  function onScroll() {
    requestAnimationFrame(() => {
      const el = document.documentElement;
      const bar = document.getElementById('scroll-progress');
      if (bar) bar.style.width = `${(el.scrollTop / (el.scrollHeight - el.clientHeight)) * 100}%`;
    });
  }

  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('#filterButtons button');
    if (!buttons.length) return;
    const items = document.querySelectorAll<HTMLElement>('#gallery .certCard');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const topic = btn.dataset.topic!;
        buttons.forEach((b) => b.classList.toggle('active', b === btn));
        items.forEach((it) => {
          const topics = (it.dataset.topic || '').split('|');
          it.style.display = topic === 'all' || topics.includes(topic) ? '' : 'none';
        });
      })
    );

    const overlay = document.getElementById('certOverlay')!;
    const certImg = document.getElementById('certImage') as HTMLImageElement;
    const openCert = (src: string, title: string) => {
      certImg.src = src;
      certImg.alt = `Certificate for ${title}`;
      overlay.hidden = false;
      document.body.classList.add('modal-open');
    };
    items.forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>('.view-cert');
      const title = card.querySelector<HTMLElement>('.cert-title');
      const open = () => openCert(btn!.dataset.certImg!, btn!.dataset.certTitle!);
      btn?.addEventListener('click', open);
      title?.addEventListener('click', open);
    });
    document.getElementById('certClose')?.addEventListener('click', closeCert);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeCert(); });

    document.removeEventListener('keydown', onKey);
    document.addEventListener('keydown', onKey);
    window.removeEventListener('scroll', onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>

<style lang="scss">
  .certs { padding: 50px 15px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1); }

  .certs .scrollProgress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 5px;
    background: var(--navbar-primary);
    z-index: 1000;
    transition: width var(--transition-speed) ease-out;
    border-radius: 0 0 5px 5px;
  }

  .certs h1 {
    text-align: center;
    font-size: 2.3rem;
    background: var(--text-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-top: 40px;
  }

  .certs .filter p { text-align: center; margin-top: -5px; font-weight: 600; color: var(--text-primary); }
  .certs .filter p::after { content: ':'; color: var(--accent); }

  .certs .filterButtons { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
  .certs .galleryWrap { margin-top: 50px; }
  .certs .gallery { display: grid; grid-template-columns: repeat(2, 1fr); grid-gap: 25px; }
  .certs .certCard { display: grid; }

  @media (min-width: 768px) {
    .certs { padding: 150px 25px; min-height: 100vh; }
    .certs .container { max-width: 1200px; margin: auto; }
    .certs h1 { font-size: 3.8rem; margin-top: -40px; }
    .certs .filter { margin-top: -30px; }
  }

  @media (min-width: 1200px) {
    .certs .gallery { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 767px) {
    .certs .scrollProgress { display: block; }
    .certs .gallery { grid-template-columns: 1fr; grid-gap: 0; }
  }

  // Certificate modal (centered card) — ports certItem.module.scss .modal/.overlay.
  .cert-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: cert-fade var(--transition-speed) ease-in-out;
  }
  .cert-overlay[hidden] { display: none; }
  @keyframes cert-fade { from { opacity: 0; } to { opacity: 1; } }

  .cert-modal {
    position: relative;
    background: var(--background-card);
    z-index: 1000;
    width: 90%;
    max-height: 95%;
    overflow: hidden;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    border-radius: 10px;
  }
  @media (min-width: 768px) { .cert-modal { width: 70%; max-height: 85%; } }
  @media (min-width: 1024px) { .cert-modal { width: 60%; max-height: 80%; } }

  .cert-close {
    background: var(--background-card);
    border: none;
    font-size: 1.5rem;
    position: absolute;
    top: 10px;
    right: 10px;
    cursor: pointer;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    transition: background-color var(--transition-speed) ease, transform var(--transition-speed) ease;
  }
  .cert-close:hover { background-color: var(--background-secondary); transform: scale(1.1); }

  .cert-image { display: block; max-width: 100%; max-height: 85vh; width: auto; height: auto; margin: 0 auto; border-radius: 5px; }
</style>
