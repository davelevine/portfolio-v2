---
// Certs — index, grouped by status like /decisions groups by year; each row links to its detail page.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatMonth, certStatus } from '../../lib/format';

const certs = (await getCollection('certs')).sort(
  (a, b) => new Date(b.data.achievedDate).valueOf() - new Date(a.data.achievedDate).valueOf()
);
const groups = [
  { title: 'Current', certs: certs.filter((c) => certStatus(c.data.expirationDate) !== 'Expired') },
  { title: 'Expired', certs: certs.filter((c) => certStatus(c.data.expirationDate) === 'Expired') },
];
const range = (earned: string, expires: string) =>
  expires === 'Never'
    ? `${formatMonth(new Date(earned))}, no expiry`
    : `${formatMonth(new Date(earned))} – ${formatMonth(new Date(expires))}`;
---

<Layout title="Certs | Dave Levine" description="Certifications Dave Levine holds.">
  <main class="wrap">
    <header class="page-header">
      <h1>Certs</h1>
      <p class="lede">Certifications I've earned over the years.</p>
    </header>

    {groups.filter((g) => g.certs.length).map((g) => (
      <>
        <h2 class="section-rule"><span>{g.title}</span></h2>
        {g.certs.map((c) => (
          <div class="post-row">
            <a class="post-title" href={`/certs/${c.id}/`}>{c.data.title}</a>
            <span class="post-date">{range(c.data.achievedDate, c.data.expirationDate)}</span>
          </div>
        ))}
      </>
    ))}
  </main>
</Layout>
