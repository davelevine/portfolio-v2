---
// Certs — index; each row links to its detail page.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatMonth, certStatus } from '../../lib/format';

const certs = (await getCollection('certs')).sort(
  (a, b) => new Date(b.data.achievedDate).valueOf() - new Date(a.data.achievedDate).valueOf()
);
const expiry = (e: string) => (e === 'Never' ? 'no expiry' : formatMonth(new Date(e)));
---

<Layout title="Certs | Dave Levine" description="Certifications Dave Levine holds.">
  <main class="wrap">
    <header class="page-header">
      <h1>Certs</h1>
      <p class="lede">Certifications I've earned over the years.</p>
    </header>

    <div class="uses-group">
      {certs.map((c) => (
        <div class="uses-row">
          <a class="uses-row-title" href={`/certs/${c.id}/`}>{c.data.title}</a>
          <p class="uses-row-desc">{c.data.excerpt}</p>
          <p class="uses-row-meta">
            {formatMonth(new Date(c.data.achievedDate))} – {expiry(c.data.expirationDate)}
            <span class="meta-tag">{certStatus(c.data.expirationDate)}</span>
          </p>
        </div>
      ))}
    </div>
  </main>
</Layout>
