---
// Writing post — Heap-style article: tags row, title, mono meta, prose, end mark.
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, readingTime } from '../../lib/format';
import { categoryHref } from '../../lib/writing';
import AilBadge from '../../components/AilBadge.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, category, categories = [], isFeatured, ail, ailImages } = post.data;
const topics = [...new Set(categories.map((c) => c.toLowerCase()))];
---

<Layout title={`${title} | Dave Levine`} description={description}>
  <main class="wrap">
    <article>
      <header class="post-header">
        {(isFeatured || topics.length > 0 || ail !== undefined) && (
          <div class="post-tags">
            {isFeatured && <a class="tag-text" href="/writing/favorites/" title="Favorite post" aria-label="Favorite post">&#10084;&#65039;</a>}
            {topics.map((t) => <span class="tag-text">#{t}</span>)}
            <AilBadge ail={ail} ailImages={ailImages} />
          </div>
        )}
        <h1>{title}</h1>
        <p class="post-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time> in <a href={categoryHref(category)}>{category}</a> · {readingTime(post.body)} min read
        </p>
      </header>

      <div class="prose writing-post">
        <Content />
      </div>
      <div class="end-mark" aria-hidden="true"></div>
      <a class="more-link" href="/writing/">&larr; All writing</a>
    </article>
  </main>
</Layout>

<script>
  // Code-copy buttons and image lightbox.
  import { Fancybox } from '@fancyapps/ui';
  import '@fancyapps/ui/dist/fancybox/fancybox.css';

  const COPY =
    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  const CHECK =
    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.writing-post')) return;

    document.querySelectorAll('.writing-post pre.astro-code:not([data-cb])').forEach((pre) => {
      pre.setAttribute('data-cb', '');
      const container = document.createElement('div');
      container.className = 'code-block';
      pre.parentNode!.insertBefore(container, pre);
      const btn = document.createElement('button');
      btn.className = 'copy-code-button';
      btn.type = 'button';
      btn.innerHTML = COPY;
      btn.title = 'Copy code to clipboard';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      container.append(btn, pre);
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(pre.innerText).then(() => {
          btn.innerHTML = CHECK;
          setTimeout(() => (btn.innerHTML = COPY), 2000);
        });
      });
    });

    document.querySelectorAll('.writing-post img:not([data-fb])').forEach((img) => {
      img.setAttribute('data-fb', '');
      const a = document.createElement('a');
      a.href = (img as HTMLImageElement).src;
      a.dataset.fancybox = 'post';
      if (img.getAttribute('alt')) a.dataset.caption = img.getAttribute('alt')!;
      img.parentNode!.insertBefore(a, img);
      a.appendChild(img);
    });
    Fancybox.unbind('[data-fancybox="post"]');
    Fancybox.bind('[data-fancybox="post"]', {
      Toolbar: { display: { left: ['counter'], middle: [], right: ['zoomIn', 'fullscreen', 'download'] } },
    });
  });
</script>
