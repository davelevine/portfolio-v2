---
// Writing archive — favorite posts only.
import Layout from '../../layouts/Layout.astro';
import WritingArchive from '../../components/WritingArchive.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing', (p) => p.data.isFeatured);
---

<Layout title="Favorites | Dave Levine" description="Dave Levine's favorite posts.">
  <main class="wrap">
    <header class="page-header">
      <h1>Favorites</h1>
      <p class="lede">The posts I'd point someone to first.</p>
    </header>
    <WritingArchive posts={posts} active="favorites" />
  </main>
</Layout>
