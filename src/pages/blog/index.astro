---
// Blog archive — all posts.
import Layout from '../../layouts/Layout.astro';
import BlogArchive from '../../components/BlogArchive.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<Layout title="Writing | Dave Levine" description="Notes on infrastructure, security, and how work gets done.">
  <main class="wrap">
    <header class="page-header">
      <h1>Writing</h1>
      <p class="lede">Notes on infrastructure, security, and documentation, from work and the homelab.</p>
    </header>
    <BlogArchive posts={posts} active="all" />
  </main>
</Layout>
