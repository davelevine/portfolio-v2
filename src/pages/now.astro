---
// Now — rendered from the markdown entry, wrapped in the new prose layout.
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('now', 'now');
const { Content } = await render(entry!);
const nowDate = entry!.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
---

<Layout title="Here and Now | Dave Levine" description="What Dave Levine is focused on now.">
  <main class="wrap">
    <header class="page-header">
      <h1>Here and Now</h1>
      <p class="lede">Updated {nowDate}</p>
    </header>

    <article class="prose">
      <Content />
    </article>
  </main>
</Layout>
