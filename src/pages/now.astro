---
// Now — rendered from the markdown entry, wrapped in the new prose layout.
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { formatDate } from '../lib/format';

const entry = await getEntry('now', 'now');
const { Content } = await render(entry!);
const nowDate = formatDate(entry!.data.date);
---

<Layout title="Here and Now | Dave Levine" description="What Dave Levine is focused on now.">
  <main class="wrap">
    <header class="page-header">
      <h1>Here and Now</h1>
      <p class="post-meta">Updated {nowDate}</p>
    </header>

    <article class="prose now-body">
      <Content />
    </article>
    <div class="end-mark" aria-hidden="true"></div>
  </main>
</Layout>
