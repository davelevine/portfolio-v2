---
// Contact — Formspree form (plain POST without JS, inline status with JS) + other channels.
import Layout from '../layouts/Layout.astro';

const endpoint = 'https://formspree.io/f/xzbloaed';
// Cloudflare Turnstile sitekey (public). Formspree verifies the token; the secret lives in
// the Formspree form settings (Cloudflare Turnstile).
const turnstileSitekey = '0x4AAAAAAFE4sbtlDVsHJpzy';
---

<Layout title="Contact | Dave Levine" description="Get in touch with Dave Levine.">
  <main class="wrap">
    <header class="page-header">
      <h1>Contact</h1>
      <p class="lede">Questions, ideas, or just want to compare homelab notes?</p>
    </header>

    <h2 class="section-rule"><span>Send a message</span></h2>
    <form class="contact-form" id="contact-form" action={endpoint} method="POST">
      <label for="email">Your email</label>
      <input id="email" type="email" name="email" required autocomplete="email" placeholder="Where can I send a response?" />

      <label for="message">Message</label>
      <textarea id="message" name="message" required rows="7" placeholder="What would you like to talk about?"></textarea>

      {/* Formspree honeypot: bots fill it, people never see it. */}
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />

      <div class="turnstile" id="turnstile" data-sitekey={turnstileSitekey}></div>

      <div class="form-actions">
        <button type="submit" class="btn">Send message</button>
        <p class="form-status" id="form-status" role="status"></p>
      </div>
    </form>

    <h2 class="section-rule"><span>Elsewhere</span></h2>
    <div class="post-row">
      <a class="post-title" href="https://www.linkedin.com/in/iamdavelevine" target="_blank" rel="noreferrer">LinkedIn</a>
      <span class="post-date">Work history</span>
    </div>
    <div class="post-row">
      <a class="post-title" href="https://cdn.levine.io/uploads/portfolio/public/assets/dave.levine.io-pgp-key-pub.asc">PGP key</a>
      <span class="post-date">For encrypted email</span>
    </div>
  </main>
</Layout>

<script>
  declare global {
    interface Window {
      turnstile?: {
        render: (el: HTMLElement, opts: Record<string, unknown>) => string;
        execute: (id: string) => void;
        reset: (id: string) => void;
        remove: (id: string) => void;
      };
    }
  }

  // Turnstile renders explicitly: ClientRouter doesn't re-run its implicit render when
  // /contact is reached by client-side navigation. The API script loads once per visit.
  let turnstileApi: Promise<void> | undefined;
  const loadTurnstile = () =>
    (turnstileApi ??= new Promise<void>((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('Turnstile failed to load'));
      document.head.append(s);
    }));

  // Bound per astro:page-load (bundled scripts run once under ClientRouter).
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    const box = document.getElementById('turnstile');
    if (!form || !status || !box) return;
    const button = form.querySelector('button')!;
    const show = (text: string, kind = '') => {
      status.className = `form-status ${kind}`.trim();
      status.textContent = text;
    };

    // The check runs only when Send is clicked, and the widget stays hidden unless
    // Cloudflare needs the visitor to click a checkbox.
    // ponytail: theme is read once at render; toggling the site theme doesn't restyle an
    // already-rendered widget until the next visit.
    let widget: string | undefined;
    let pending: { resolve: (token: string) => void; reject: () => void } | undefined;
    const ready = loadTurnstile().then(() => {
      widget = window.turnstile!.render(box, {
        sitekey: box.dataset.sitekey,
        theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
        execution: 'execute',
        appearance: 'interaction-only',
        callback: (token: string) => pending?.resolve(token),
        'error-callback': () => pending?.reject(),
        'before-interactive-callback': () => {
          box.classList.add('shown');
          show("Please confirm you're not a bot.");
        },
        'after-interactive-callback': () => box.classList.remove('shown'),
      });
    });
    ready.catch(() => {}); // surfaced on send
    document.addEventListener('astro:before-swap', () => widget && window.turnstile?.remove(widget), { once: true });

    const verify = () =>
      ready.then(
        () =>
          new Promise<string>((resolve, reject) => {
            pending = { resolve, reject };
            window.turnstile!.execute(widget!);
          })
      );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      show('Sending…');
      try {
        let token: string;
        try {
          token = await verify();
        } catch {
          show('The spam check failed. Please refresh and try again.', 'error');
          return;
        }
        const data = new FormData(form);
        data.set('cf-turnstile-response', token);
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          show("Thanks for reaching out! I'll get back to you soon.", 'ok');
        } else {
          const body = await res.json().catch(() => ({}));
          show(body?.errors?.[0]?.message || 'Something went wrong. Please try again.', 'error');
        }
      } catch {
        show('Could not send your message. Please try again.', 'error');
      } finally {
        // Tokens are single-use: clear it so the next send runs a fresh check.
        pending = undefined;
        if (widget) window.turnstile?.reset(widget);
        button.disabled = false;
      }
    });
  });
</script>
