---
// Not found — Cloudflare Pages serves dist/404.html with a 404 status for unknown paths.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Dave Levine" description="This page doesn't exist.">
  <main class="wrap">
    <header class="page-header">
      <h1>Page not found</h1>
      <p class="lede">This page doesn't exist or has moved. Try the <a href="/">home page</a> or <a href="/writing/">writing</a>.</p>
    </header>
  </main>
</Layout>
