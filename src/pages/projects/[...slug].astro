---
// Project detail — article layout: tech tags, title, links, screenshot, prose.
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tech, image, githubLink, githubComingSoon, liveLink } = project.data;
const cdn = 'https://cdn.levine.io/uploads/portfolio/public/images/projects';
const imageSrc = image?.startsWith('http') ? image : `${cdn}/${image}`;
---

<Layout title={`${title} | Dave Levine`} description={description}>
  <main class="wrap">
    <article>
      <header class="post-header">
        <div class="post-tags">
          {tech.map((t) => <span class="meta-tag">{t}</span>)}
        </div>
        <h1>{title}</h1>
        <p class="post-meta">
          {liveLink && <a href={liveLink} target="_blank" rel="noreferrer">Website</a>}
          {liveLink && (githubLink || githubComingSoon) && ' · '}
          {githubLink && <a href={githubLink} target="_blank" rel="noreferrer">GitHub</a>}
          {!githubLink && githubComingSoon && <span>GitHub coming soon</span>}
        </p>
      </header>

      {image && <img class="lead-image" src={imageSrc} alt={`${title} screenshot`} fetchpriority="high" />}

      <div class="prose">
        <Content />
      </div>
      <div class="end-mark" aria-hidden="true"></div>
      <a class="more-link" href="/projects/">&larr; All projects</a>
    </article>
  </main>
</Layout>
