---
// Projects — index; each row links to its detail page.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.isFeatured) - Number(a.data.isFeatured)
);
---

<Layout title="Projects | Dave Levine" description="Projects Dave Levine has built.">
  <main class="wrap">
    <header class="page-header">
      <h1>Projects</h1>
      <p class="lede">Things I've built, mostly to solve problems I had or to learn how something works.</p>
    </header>

    <div class="uses-group">
      {projects.map((p) => (
        <div class="uses-row">
          <a class="uses-row-title" href={`/projects/${p.id}/`}>{p.data.title}</a>
          <p class="uses-row-desc">{p.data.summary ?? p.data.description}</p>
          <p class="uses-row-meta">{p.data.tech.join(' · ')}</p>
        </div>
      ))}
    </div>
  </main>
</Layout>
