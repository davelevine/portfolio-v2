---
// Projects list — ports pages/projects/index.js + components/projects/allProjects.js.
import Layout from '../../layouts/Layout.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import { getCollection } from 'astro:content';

const cdn = 'https://cdn.levine.io/uploads/portfolio/public/images/projects';
const logo = (t: string) => `${cdn}/logos/${encodeURIComponent(t)}.svg`;

const projects = (await getCollection('projects')).sort((a, b) => {
  const da = a.data.date ? a.data.date.valueOf() : 0;
  const db = b.data.date ? b.data.date.valueOf() : 0;
  return db - da;
});
const ordered = [...projects].sort(
  (a, b) => (b.data.isFeatured ? 1 : 0) - (a.data.isFeatured ? 1 : 0)
);
const techs = [...new Set(projects.flatMap((p) => p.data.tech))].sort();
---

<Layout title="Projects" description="List of all of my projects.">
  <section class="projectsGallery">
    <div id="scroll-progress" class="scrollProgress"></div>

    <div class="container">
      <h1>PROJECTS</h1>

      <div class="filter">
        <h3><p>Sort By Tech</p></h3>
        <div class="filterButtons" id="filterButtons">
          <button class="btn btn-outlined sm active" data-tech="all" aria-label="Show all projects">
            <span class="techLogoContainer">
              <i class="fa-regular fa-asterisk" aria-hidden="true"></i>
              <span class="techLogoName">All</span>
            </span>
          </button>
          {techs.map((t) => (
            <button class="btn btn-outlined sm" data-tech={t} aria-label={`Filter projects by ${t}`}>
              <span class="techLogoContainer">
                <img class="techLogo" src={logo(t)} alt={t} width="32" height="32" loading="lazy" />
                <span class="techLogoName">{t}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="galleryWrap">
        <div class="gallery" id="gallery">
          {ordered.map((p) => (
            <div class="projectCard" data-tech={p.data.tech.join('|')}>
              <ProjectItem
                title={p.data.title}
                tech={p.data.tech}
                image={p.data.image}
                description={p.data.description}
                githubLink={p.data.githubLink}
                githubComingSoon={p.data.githubComingSoon}
                liveLink={p.data.liveLink}
                slug={p.id}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#filterButtons button');
  const items = document.querySelectorAll<HTMLElement>('#gallery .projectCard');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const tech = btn.dataset.tech!;
      buttons.forEach((b) => b.classList.toggle('active', b === btn));
      items.forEach((it) => {
        const techs = (it.dataset.tech || '').split('|');
        it.style.display = tech === 'all' || techs.includes(tech) ? '' : 'none';
      });
    })
  );

  const bar = document.getElementById('scroll-progress');
  const onScroll = () =>
    requestAnimationFrame(() => {
      const el = document.documentElement;
      const pct = (el.scrollTop / (el.scrollHeight - el.clientHeight)) * 100;
      if (bar) bar.style.width = `${pct}%`;
    });
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style lang="scss">
  .projectsGallery { padding: 50px 15px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1); }

  .projectsGallery .scrollProgress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 5px;
    background: var(--navbar-primary);
    z-index: 1000;
    transition: width var(--transition-speed) ease-out;
    border-radius: 0 0 5px 5px;
  }

  .projectsGallery h1 {
    text-align: center;
    font-size: 2.3rem;
    background: var(--text-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-top: 40px;
  }

  .projectsGallery .filter p { text-align: center; margin-top: -5px; font-weight: 600; color: var(--text-primary); }
  .projectsGallery .filter p::after { content: ':'; color: var(--accent); }

  .projectsGallery .filterButtons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    transition: transform var(--transition-speed) ease, color var(--transition-speed) ease;
  }

  // Circular tech-filter buttons (scoped to projects so the blog's text chips are unaffected).
  .projectsGallery .filterButtons button {
    width: 48px;
    height: 48px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    overflow: visible;
  }
  .projectsGallery .filterButtons button img,
  .projectsGallery .filterButtons button .fa-asterisk { max-width: 60%; max-height: 60%; font-size: 1.5rem; }
  .projectsGallery .techLogoContainer { position: relative; display: flex; align-items: center; justify-content: center; text-align: center; }
  .projectsGallery .techLogoName {
    display: none;
    position: absolute;
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--transparent-secondary);
    color: var(--accent);
    padding: 2px 8px;
    border-radius: 4px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    font-size: 12px;
    white-space: nowrap;
    z-index: 1;
  }
  .projectsGallery .techLogoContainer:hover .techLogoName { display: block; }

  .projectsGallery .galleryWrap { margin-top: 50px; }
  .projectsGallery .gallery { display: grid; grid-template-columns: 1fr; gap: 25px; }

  @media (min-width: 768px) {
    .projectsGallery { padding: 150px 25px; min-height: 100vh; margin-bottom: 0; }
    .projectsGallery .container { max-width: 1200px; margin: auto; }
    .projectsGallery h1 { font-size: 3.8rem; margin-top: -40px; }
    .projectsGallery .filter { margin-top: -30px; }
    .projectsGallery .gallery { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1080px) {
    .projectsGallery .gallery { grid-template-columns: repeat(3, 1fr); }
  }

  [data-theme='dark'] .projectsGallery .techLogoName { background: var(--button-border); color: var(--text-primary); }
</style>
