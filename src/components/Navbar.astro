---
// Navbar — Heap-style: primary links, divider, social icons, theme toggle.
// Secondary pages live in the mobile menu's second row and the footer.
const primary = [
  { path: '/', label: 'Home' },
  { path: '/writing', label: 'Writing' },
  { path: '/projects', label: 'Projects' },
  { path: '/certs', label: 'Certs' },
  { path: '/decisions', label: 'Decisions' },
];
const secondary = [
  { path: '/about', label: 'About' },
  { path: '/now', label: 'Now' },
  { path: '/uses', label: 'Uses' },
];

const norm = (p: string) => (p.endsWith('/') ? p.slice(0, -1) : p);
const current = norm(Astro.url.pathname) || '/';
const isActive = (path: string) =>
  path === '/' ? current === '/' : current === path || current.startsWith(path + '/');
const href = (path: string) => (path === '/' ? '/' : `${path}/`);
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a class="brand" href="/">
      <span class="bracket">&lt;/</span>Dave Levine<span class="bracket">&gt;</span>
    </a>

    <div class="nav-desktop">
      {primary.map((l) => (
        <a class:list={['nav-link', { active: isActive(l.path) }]} href={href(l.path)}>{l.label}</a>
      ))}
      <span class="nav-divider" aria-hidden="true"></span>
      <div class="nav-icons">
        <a href="https://github.com/davelevine" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.1-4.55-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 012.5-.34c.85.01 1.7.11 2.5.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.21 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10 10 0 0022 12c0-5.52-4.48-10-10-10z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/iamdavelevine" target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn">
          <svg class="icon-linkedin" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="/rss.xml" aria-label="RSS" title="RSS">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 15.64A2.18 2.18 0 0 1 8.36 17.82C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
        </a>
      </div>
      <button class="theme-toggle" type="button" title="Toggle theme" aria-label="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.36.89-1.59 1.59M21 12h-2.25m-.39 6.36-1.59-1.59M12 18.75V21m-4.77-4.23-1.59 1.59M5.25 12H3m4.23-4.77-1.59-1.59M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 15.002A9.72 9.72 0 0 1 18 15.75c-5.39 0-9.75-4.36-9.75-9.75 0-1.33.27-2.6.75-3.75A9.75 9.75 0 0 0 3 11.25C3 16.64 7.36 21 12.75 21a9.75 9.75 0 0 0 9-5.998Z"/></svg>
      </button>
    </div>

    <button class="menu-toggle" id="menuBtn" type="button" aria-label="Toggle menu" aria-controls="mobile-menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"/></svg>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu">
    {primary.map((l) => (
      <a class:list={['nav-link', { active: isActive(l.path) }]} href={href(l.path)}>{l.label}</a>
    ))}
    <div class="mobile-secondary">
      {secondary.map((l) => (
        <a class:list={['nav-link', { active: isActive(l.path) }]} href={href(l.path)}>{l.label}</a>
      ))}
      <button class="theme-toggle" type="button" title="Toggle theme" aria-label="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.36.89-1.59 1.59M21 12h-2.25m-.39 6.36-1.59-1.59M12 18.75V21m-4.77-4.23-1.59 1.59M5.25 12H3m4.23-4.77-1.59-1.59M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 15.002A9.72 9.72 0 0 1 18 15.75c-5.39 0-9.75-4.36-9.75-9.75 0-1.33.27-2.6.75-3.75A9.75 9.75 0 0 0 3 11.25C3 16.64 7.36 21 12.75 21a9.75 9.75 0 0 0 9-5.998Z"/></svg>
      </button>
    </div>
  </div>
</nav>

<script>
  function toggleTheme() {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    document.getElementById('theme-color-meta')?.setAttribute('content', next === 'dark' ? '#202122' : '#faf6ef');
  }

  // Re-bind on every page-load: the navbar is re-rendered on each navigation.
  document.addEventListener('astro:page-load', () => {
    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobile-menu');
    document.querySelectorAll('.site-nav .theme-toggle').forEach((b) => b.addEventListener('click', toggleTheme));
    if (!menuBtn || !mobileMenu) return;
    menuBtn.addEventListener('click', () => {
      menuBtn.setAttribute('aria-expanded', String(mobileMenu.classList.toggle('open')));
    });
    mobileMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => mobileMenu.classList.remove('open')));
  });
</script>
