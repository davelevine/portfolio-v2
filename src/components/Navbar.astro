---
// Navbar — ports components/layout/navbar/{navbar,themeToggle,menuToggle}.js.
// framer-motion dropped in favor of CSS transitions + a small client script.
const links = [
  { path: '/', label: 'HOME' },
  { path: '/projects', label: 'PROJECTS' },
  { path: '/certs', label: 'CERTS' },
  { path: '/blog', label: 'BLOG' },
  { path: '/now', label: 'NOW' },
  { path: '/about', label: 'ABOUT ME' },
];

const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const current = norm(Astro.url.pathname);
const isActive = (path: string) =>
  path === '/' ? current === '/' : current === path || current.startsWith(path + '/');
---

<div class="navbar" id="navbar">
  <div class="container">
    <a href="/" class="logo"><span class="name">&lt;</span>/DAVE LEVINE<span class="name">&gt;</span></a>

    <nav class="navMenu" id="navMenu">
      <div class="linkWrapper">
        {links.map((l) => (
          <a href={l.path} class={isActive(l.path) ? 'activeLink' : ''} data-nav-link>{l.label}</a>
        ))}
      </div>
    </nav>

    <div class="navContainer">
      <button class="icon" id="contactBtn" aria-label="Toggle Contact Modal">
        <i class="fa fa-envelope" id="contact-icon"></i>
      </button>

      <div class="themeToggleContainer">
        <button class="icon" id="themeBtn" aria-label="Toggle Theme">
          <i class="fa fa-moon" id="theme-icon"></i>
        </button>
      </div>

      <button class="icon iconMain" id="menuBtn" aria-label="Toggle Mobile Menu">
        <svg width="45" height="45" viewBox="0 0 23 23">
          <path class="line top" fill="transparent" stroke-width="3" stroke-linecap="round" d="M 2 2.5 L 20 2.5" />
          <path class="line mid" fill="transparent" stroke-width="3" stroke-linecap="round" d="M 2 9.423 L 20 9.423" />
          <path class="line bot" fill="transparent" stroke-width="3" stroke-linecap="round" d="M 2 16.346 L 20 16.346" />
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  // The navbar is NOT transition:persist'd. Persisting it corrupts its layout when it
  // is carried through a View Transition after the mobile menu has been opened: the
  // menu links spill across the bar (a bare desktop-looking navbar) on the next page.
  // Re-rendering it per navigation avoids that, but Astro runs this module only once
  // per session — so (re)bind element-scoped listeners on every astro:page-load, and
  // register the document/window listeners a single time (they re-query live elements).
  // The theme is owned by <html> (so the root background follows it — no flash) and
  // <html> survives navigations, so it is safe to read live each time.
  const root = document.documentElement;
  const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);

  const syncThemeIcon = () => {
    const dark = root.getAttribute('data-theme') !== 'light';
    const themeIcon = document.getElementById('theme-icon');
    if (themeIcon) themeIcon.className = `fa ${dark ? 'fa-moon' : 'fa-sun'}`;
    const meta = document.getElementById('theme-color-meta');
    if (meta) meta.setAttribute('content', dark ? '#121212' : '#ffffff');
  };

  const updateActive = () => {
    const navMenu = document.getElementById('navMenu');
    if (!navMenu) return;
    const cur = norm(location.pathname);
    navMenu.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]').forEach((a) => {
      const path = norm(new URL(a.href).pathname);
      const active = path === '/' ? cur === '/' : cur === path || cur.startsWith(path + '/');
      a.classList.toggle('activeLink', active);
    });
  };

  // Re-bind the freshly-rendered navbar on every page load (initial + each navigation).
  const bind = () => {
    const menuBtn = document.getElementById('menuBtn');
    const navMenu = document.getElementById('navMenu');
    const themeBtn = document.getElementById('themeBtn');
    const contactBtn = document.getElementById('contactBtn');
    if (!menuBtn || !navMenu || !themeBtn || !contactBtn) return;

    syncThemeIcon();

    // Theme toggle — flips <html>[data-theme]; remembered in sessionStorage so it
    // survives client-side navigations (re-applied in Layout on after-swap).
    themeBtn.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') !== 'light' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      sessionStorage.setItem('theme', next);
      syncThemeIcon();
    });

    // Mobile menu (delegated so it survives independent of link identity).
    menuBtn.addEventListener('click', () => {
      menuBtn.classList.toggle('open');
      navMenu.classList.toggle('responsive');
    });
    navMenu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-nav-link]') && window.innerWidth <= 768) {
        menuBtn.classList.remove('open');
        navMenu.classList.remove('responsive');
      }
    });

    // Contact modal trigger.
    contactBtn.addEventListener('click', () =>
      document.dispatchEvent(new CustomEvent('modal:open', { detail: { type: 'contact' } }))
    );

    updateActive();
  };

  // Document/window listeners — registered once; they re-query the live navbar.
  let t: number | undefined;
  window.addEventListener(
    'scroll',
    () => {
      window.clearTimeout(t);
      t = window.setTimeout(() => {
        const navbar = document.getElementById('navbar');
        if (navbar) navbar.classList.toggle('sticky', window.scrollY >= 100);
      }, 100);
    },
    { passive: true }
  );
  document.addEventListener('modal:open', (e) => {
    if ((e as CustomEvent).detail?.type !== 'contact') return;
    const ci = document.getElementById('contact-icon');
    if (ci) ci.className = 'fa fa-envelope-open';
  });
  document.addEventListener('modal:closed', () => {
    const ci = document.getElementById('contact-icon');
    if (ci) ci.className = 'fa fa-envelope';
  });

  document.addEventListener('astro:page-load', bind);
</script>

<style lang="scss">
  .navbar {
    z-index: 2;
    height: 4.0625rem;
    width: 100%;
    position: fixed;
    background-color: var(--background);
    transition: background 0.3s;
    margin-bottom: 0;
    animation: navbar-drop 0.5s ease-in-out both;
  }

  // Entrance animations (replace the framer-motion navbar/link/button variants).
  // Links share a start time but each has a LONGER duration (0.5 + i*0.075) — they
  // all drop together and settle in sequence (framer's per-item duration, not delay).
  @keyframes navbar-drop { from { transform: translateY(-100px); } to { transform: translateY(0); } }
  @keyframes nav-item-in { from { opacity: 0; transform: translateY(-100px); } to { opacity: 1; transform: translateY(0); } }

  .navMenu .linkWrapper a { opacity: 0; animation: nav-item-in 0.5s ease-in-out forwards; }
  .navMenu .linkWrapper a:nth-child(1) { animation-duration: 0.5s; }
  .navMenu .linkWrapper a:nth-child(2) { animation-duration: 0.575s; }
  .navMenu .linkWrapper a:nth-child(3) { animation-duration: 0.65s; }
  .navMenu .linkWrapper a:nth-child(4) { animation-duration: 0.725s; }
  .navMenu .linkWrapper a:nth-child(5) { animation-duration: 0.8s; }
  .navMenu .linkWrapper a:nth-child(6) { animation-duration: 0.875s; }

  .navContainer .icon { opacity: 0; animation: nav-item-in 0.7s ease-in-out forwards; }
  .navContainer .themeToggleContainer .icon { animation-duration: 0.75s; }

  // After the first page of a session, skip the entrance (no replay per navigation).
  // :global() so Astro doesn't scope the <html> flag class.
  :global(html.nav-seen) .navbar { animation: none; }
  :global(html.nav-seen) .navMenu .linkWrapper a,
  :global(html.nav-seen) .navContainer .icon { animation: none; opacity: 1; }

  .navbar.sticky {
    position: fixed;
    top: 0;
    background-color: var(--background);
    box-shadow: 0 0.375rem 1.875rem 0.125rem rgba(0, 0, 0, 0.03),
                0 0.1875rem 0.9375rem 0.0625rem rgba(0, 0, 0, 0.02),
                0 0.0625rem 0.5rem 0.0625rem rgba(0, 0, 0, 0.01);
  }

  .navbar .container {
    display: flex;
    align-items: center;
    height: 100%;
    margin: 0 auto;
  }

  .navbar .logo {
    z-index: 3;
    font-weight: bold;
    background-color: transparent;
    color: var(--navbar-primary);
    border-radius: 50%;
    padding: 0.3125rem;
    font-size: 1rem;
    width: 2.8125rem;
    height: 1.875rem;
    box-shadow: none;
    margin-right: auto;
    margin-left: 1.25rem;
    white-space: nowrap;
    transition: color 0.3s;
  }

  .navbar .logo .name { color: var(--background-secondary); }
  .navbar .logo:hover { color: var(--text-secondary); }

  .navbar .navMenu {
    height: 0;
    overflow: hidden;
    transition: all 0.4s ease;
    position: absolute;
    top: 0;
    padding-top: 4.0625rem;
    margin-left: auto;
  }

  .navbar .navMenu a {
    font-size: 1.3rem;
    color: var(--navbar-primary);
    border-bottom: 0.0625rem solid var(--border);
    cursor: pointer;
  }

  .navbar .navMenu a:first-child { border-top: 0.0625rem solid var(--border); }
  .navbar .navMenu .linkWrapper a:hover { color: var(--background-secondary); }
  .navbar .navMenu .activeLink { color: var(--text-secondary); }

  .navbar .navMenu.responsive {
    height: auto;
    width: 100%;
    display: block;
    text-align: center;
    right: 0;
    background-color: var(--transparent-primary);
  }

  .navbar .navMenu.responsive a { display: block; padding: 1.5625rem 0; }

  .navbar .navContainer {
    position: relative;
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  .navbar .navContainer .icon {
    cursor: pointer;
    background-color: transparent;
    border: none;
  }

  .navbar .navContainer .icon i,
  .navbar .navContainer .icon svg {
    font-size: 1.5rem;
    color: var(--navbar-primary);
    padding: 0.3125rem;
  }

  .navbar .navContainer .icon path { stroke: var(--navbar-primary); }

  .navbar .navContainer .icon:hover i,
  .navbar .navContainer .icon:hover svg { color: var(--background-secondary); }

  .navbar .navContainer .themeToggleContainer {
    width: 2.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  // Hamburger → X morph (replaces framer-motion path variants).
  .iconMain .line {
    transition: transform 0.3s ease, opacity 0.2s ease;
    transform-origin: center;
    transform-box: fill-box;
  }
  .iconMain.open .top { transform: translateY(6.9px) rotate(45deg); }
  .iconMain.open .mid { opacity: 0; }
  .iconMain.open .bot { transform: translateY(-6.9px) rotate(-45deg); }

  @media only screen and (max-width: 47.9375rem) {
    .navbar .logo { margin-right: auto; }
    .navbar .navContainer .iconMain { height: 2.5rem; margin-right: 0.625rem; }
  }

  @media only screen and (min-width: 48rem) {
    .navbar .container { max-width: 79.0625rem; margin: 0 auto; }

    .navbar .navMenu {
      height: auto;
      display: flex;
      width: 90%;
      top: 0;
      padding-top: 0;
      position: static;
    }

    .navbar .navMenu.responsive { width: 45%; display: flex; background-color: transparent !important; }

    .navbar .navMenu .linkWrapper { margin: 0 auto; display: flex; justify-content: flex-end; width: 94%; }
    .navbar .navMenu .linkWrapper a { margin-left: 1.5625rem; border-bottom: none; font-size: 1.03rem; }
    .navbar .navMenu .linkWrapper a:first-child { border-top: none; margin-left: 0; }

    .navbar .logo { margin-left: 0; }
    .navbar .navContainer .iconMain { display: none; }
  }

  @media only screen and (min-width: 100rem) {
    .navbar .container { max-width: 87.5rem; }
    .navbar .navMenu .linkWrapper a { font-size: 1.03rem; }
    .navbar .logo { font-size: 1rem; }
  }
</style>
