---
// Cert card — ports components/certs/certItem.js. The react-modal certificate
// view is replaced with a GLightbox image (wired in certs/index.astro).
interface Props {
  title: string;
  excerpt: string;
  achievedDate: string;
  expirationDate: string;
  image: string;
}
const { title, excerpt, achievedDate, expirationDate, image } = Astro.props;
const cdnImg = `https://cdn.levine.io/uploads/portfolio/public/images/certs/${image}`;
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: '2-digit', year: 'numeric' });
const isNever = expirationDate === 'Never';
const expired = !isNever && new Date(expirationDate) < new Date();
---

<div class="card">
  <div class="cardContent">
    <h4 class="cert-title">{title}</h4>
    <p>{excerpt}</p>
  </div>
  <div class="dates">
    <time>
      <span class="achieved"><strong><i class="fa-regular fa-medal"></i>{fmt(achievedDate)}</strong></span>
    </time>
    <time>
      {isNever ? (
        <span class="never"><strong><i class="fa-solid fa-infinity"></i> Never</strong></span>
      ) : expired ? (
        <span class="expired"><strong><i class="fa-regular fa-calendar-xmark"></i>{fmt(expirationDate)}</strong></span>
      ) : (
        <span class="expires"><strong><i class="fa-regular fa-calendar-check"></i>{fmt(expirationDate)}</strong></span>
      )}
    </time>
  </div>
  <div class="cardAction">
    <button class="view-cert" type="button" data-cert-img={cdnImg} data-cert-title={title} aria-label={`View certificate for ${title}`}>
      <i class="fa-regular fa-arrow-up-right-from-square"></i> View Certificate
    </button>
  </div>
</div>

<style lang="scss">
  .card {
    border-radius: 8px;
    padding: 20px;
    background-color: var(--background-card);
    transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease;
    border: 1px solid var(--border-card);
    margin-bottom: 25px;
    display: flex;
    flex-direction: column;
    text-align: center;
    min-height: 260px;

    &:hover { transform: scale(1.02); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2); }

    h4 {
      color: var(--text-secondary);
      font-size: 1.15rem;
      margin-bottom: 0;
      cursor: pointer;
      min-height: 3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
  }

  .cardContent { flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; text-align: center; }
  .cardContent p { color: var(--text-primary); margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; }

  .cardAction { display: flex; justify-content: center; margin-top: 10px; }
  .cardAction button {
    color: var(--text-primary);
    background: none;
    border: none;
    cursor: pointer;
    font-size: inherit;
    font-weight: bold;
    text-decoration: none;
    padding: 0;
    transition: color var(--transition-speed) ease, transform var(--transition-speed) ease, text-decoration var(--transition-speed) ease;
    display: flex;
    align-items: center;
    &:hover { color: var(--link-hover); transform: scale(1.1); text-decoration: underline; }
    i { color: var(--accent); margin-right: 5px; }
  }

  .dates { display: flex; justify-content: space-evenly; gap: 20px; margin-top: auto; }
  .dates time { display: flex; align-items: center; color: var(--text-primary); font-weight: bold; }

  .achieved i { color: var(--valid-cert); margin-right: 5px; }
  .expires i { color: var(--valid-cert); margin-right: 5px; }
  .expired i { color: var(--accent); margin-right: 5px; }
  .never i { color: var(--valid-forever-cert); margin-right: 5px; }

  @media only screen and (min-width: 768px) {
    .card { margin-bottom: unset; }
  }
</style>
